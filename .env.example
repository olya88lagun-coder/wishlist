APP_URL=https://my-wish-list.online
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Коды подтверждения сайта (значение content); по умолчанию берутся из кода главной
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
DATABASE_URL=postgres://wishlist:CHANGE_ME@db:5432/wishlist
SESSION_SECRET=generate-with-openssl-rand-hex-32
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_BOT_USERNAME=my_wish_list1_bot
# Telegram id администратора: алерты canary и проверки сайта (узнать — команда /myid боту)
ADMIN_TELEGRAM_ID=
VK_CLIENT_ID=54771492
GHCR_OWNER=olya88lagun-coder
S3_ACCESS_KEY_ID=from-timeweb-s3-panel
S3_SECRET_ACCESS_KEY=from-timeweb-s3-panel
S3_IMAGES_BUCKET=wishlist-images
S3_BACKUPS_BUCKET=wishlist-backups
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/wishlist-images

# RouterAI is used first when ROUTERAI_API_KEY is set.
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_GIFT_MODEL=openai/gpt-5.5

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_GIFT_MODEL=gpt-5.6-luna
# Ограничители расхода на AI: подборок в день на гостя и на вошедшего, дневной бюджет в рублях.
# Пустые значения означают 5, 30 и 50. AI_USD_RUB нужен для пересчёта цен OpenAI.
AI_DAILY_LIMIT_GUEST=
AI_DAILY_LIMIT_USER=
AI_DAILY_BUDGET_RUB=
AI_USD_RUB=

# Optional affiliate templates. Use {url} as the encoded original product URL.
# Leave empty until the corresponding partner program is connected.
AFFILIATE_WILDBERRIES_TEMPLATE=
AFFILIATE_OZON_TEMPLATE=
AFFILIATE_GOLDAPPLE_TEMPLATE=
AFFILIATE_LAMODA_TEMPLATE=
AFFILIATE_YANDEX_MARKET_TEMPLATE=
AFFILIATE_OTHER_TEMPLATE=
